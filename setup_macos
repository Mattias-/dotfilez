#!/bin/bash
# -E so that the ERR trap below is inherited by functions.
set -Eeuo pipefail

# Run from the repo root, packages.sh, the Brewfile, setup_dotfiles.py and the
# nix flake are all referenced relative to it.
cd "$(dirname "${BASH_SOURCE[0]}")"

# shellcheck source=./packages.sh
source ./packages.sh

# $LINENO is useless here, with errtrace it reports the line the function was
# defined on, so report the failing command and the function it was in instead.
trap 'echo_err_blue "Failed in ${FUNCNAME[0]:-main}: $BASH_COMMAND"' ERR

# Written once install_macos_packages has succeeded, so that we can tell a
# first run on a fresh machine from a repeat run.
bootstrapped_marker="$HOME/.local/state/dotfilez/macos-packages-installed"

usage() {
    cat <<EOF
Usage: ${0##*/} [--dev|--no-dev]

  --dev      Install the go, python and node packages.
  --no-dev   Skip all of the above. The toolchains take a while to build, so
             this makes the initial run of a new machine a lot faster.

  Without either flag the default is --no-dev until the macOS configuration
  been set up once ($bootstrapped_marker),
  and --dev after that.
EOF
}

main() {
    # Empty means unset, so that an explicit flag always wins over the default
    # derived from the marker below.
    local dev=""
    while [ $# -gt 0 ]; do
        case "$1" in
        --dev) dev=1 ;;
        --no-dev) dev=0 ;;
        -h | --help)
            usage
            return 0
            ;;
        *)
            echo_err_blue "Unknown argument: $1"
            usage >&2
            exit 2
            ;;
        esac
        shift
    done

    if [ -z "$dev" ]; then
        # The dev packages need the toolchains that install_macos_packages
        # brings in, so on a machine that has never got that far, skip them.
        if [ -f "$bootstrapped_marker" ]; then
            dev=1
        else
            dev=0
            echo "First run on this machine, defaulting to --no-dev"
        fi
    fi

    mkdir -p ~/screenshots
    mkdir -p ~/projects
    mkdir -p ~/work
    #mkdir -p ~/mnt
    mkdir -p ~/bin

    set_hostname
    install_macos_packages
    setup_dotfiles
    configure_macos

    mkdir -p "$(dirname "$bootstrapped_marker")"
    touch "$bootstrapped_marker"

    if [ "$dev" -eq 1 ]; then
        install_go_packages
        install_python_packages_uv
        install_node_packages
    else
        echo "Skipping the dev packages, run again with --dev to install them"
    fi

    setup_nvim
    check_git_remote
    setup_git
}

# Cloning over https is the path of least resistance, but then pushing wants a
# token. Only a hint, everything this script does works over https too.
check_git_remote() {
    local remote_url expected='ssh://git@github.com/Mattias-/dotfilez.git'
    remote_url="$(git remote get-url origin 2>/dev/null || true)"
    case "$remote_url" in
    # Both ssh://git@host/path and the scp-like git@host:path are ssh.
    ssh://* | *@*:*) return 0 ;;
    '')
        echo_err_blue "No origin remote in $PWD, skipping the remote URL check"
        return 0
        ;;
    esac
    echo_err_blue "The origin remote does not use ssh: $remote_url"
    echo "git remote set-url origin $expected"
}

# A symlinked ~/.zshrc is a good enough hint that setup_dotfiles.py has already
# been run. It is idempotent, this just keeps the common case quiet.
setup_dotfiles() {
    if [ -L "$HOME/.zshrc" ]; then
        echo "Dotfiles already linked, skipping setup_dotfiles.py"
        return 0
    fi
    echo "Linking dotfiles"
    ./setup_dotfiles.py
}

setup_nvim() {
    local nvim_path
    if nvim_path="$(command -v nvim)"; then
        ln -sf "$nvim_path" "$HOME/bin/vi"
        ln -sf "$nvim_path" "$HOME/bin/vim"
    else
        echo_err_blue "nvim not found, skipping the ~/bin/vi and ~/bin/vim symlinks"
    fi

}

setup_git() {
    # allowed_signers is derived from extraconfig, so only attempt it once
    # extraconfig exists. Otherwise create extraconfig and run the script again.
    local git_extraconfig_file="$HOME/.config/git/extraconfig"
    local allowed_signers_file="$HOME/.config/git/allowed_signers"
    local git_config_ok=1
    if ! [ -f "$git_extraconfig_file" ]; then
        git_config_ok=0
        echo_err_blue "Please create a config in $git_extraconfig_file"
        echo "git config set --file \"$git_extraconfig_file\" user.name 'Mattias Appelgren'"
        echo "git config set --file \"$git_extraconfig_file\" user.email 'mail@example.com'"
        echo "git config set --file \"$git_extraconfig_file\" user.signingkey '~/.ssh/key.pub'"
        echo 'ssh-keygen -t ed25519 -f ~/.ssh/key -C "extra-key-comment"'
    elif ! [ -f "$allowed_signers_file" ]; then
        git_config_ok=0
        echo_err_blue "Please add allowed signers to $allowed_signers_file"
        local email signingkey keydata
        email="$(git config get --file "$git_extraconfig_file" user.email || true)"
        signingkey="$(git config get --file "$git_extraconfig_file" --path user.signingkey || true)"
        if [ -z "$email" ] || [ -z "$signingkey" ]; then
            echo_err_blue "Set user.email and user.signingkey in $git_extraconfig_file first"
        elif ! [ -r "$signingkey" ]; then
            echo_err_blue "Cannot read the signing key: $signingkey"
        else
            # Only the keytype and the base64 key, dropping the comment. The
            # comment is arbitrary text, and it would end up interpolated into
            # the echo below for copy-pasting, where a quote or a $(...) in it
            # would break the command. head first, not cut | head -1, so that
            # cut cannot die of SIGPIPE and trip pipefail.
            keydata=$(head -1 "$signingkey" | cut -d' ' -f1-2)
            printf 'echo "%s namespaces=\\"git\\" %s" >"%s"\n' "$email" "$keydata" "$allowed_signers_file"
        fi
    fi
    if [ "$git_config_ok" -eq 0 ]; then
        exit 1
    fi
}

# Colour is best effort. tput fails when TERM is dumb or unset, which under
# set -e would otherwise take the whole script down instead of printing.
echo_err_blue() {
    local blue reset
    blue="$(tput setaf 33 2>/dev/null || true)"
    reset="$(tput sgr0 2>/dev/null || true)"
    printf '%s%s%s\n' "$blue" "$*" "$reset" >&2
}

# Domains that defaults_write actually changed the value of, space separated.
changed_domains=""

# Both the value and its type, so that rewriting "0.5" as a float counts as a
# change. Missing keys read as empty.
defaults_value() {
    defaults read-type "$1" "$2" 2>/dev/null || true
    defaults read "$1" "$2" 2>/dev/null || true
}

# defaults write, but records the domain when the stored value really changed,
# so we only restart the apps that need it.
defaults_write() {
    local domain="$1" key="$2"
    shift 2
    local before after
    before="$(defaults_value "$domain" "$key")"
    defaults write "$domain" "$key" "$@"
    after="$(defaults_value "$domain" "$key")"
    [ "$before" = "$after" ] && return 0
    case " $changed_domains " in
    *" $domain "*) ;;
    *) changed_domains="$changed_domains $domain" ;;
    esac
}

domain_changed() {
    case " $changed_domains " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
    esac
}

install_go_packages() {
    # shellcheck disable=SC2154
    for go_package in "${go_packages[@]}"; do
        go install "$go_package"
    done
}

install_python_packages_uv() {
    local installed pip_package
    # grep exits 1 when nothing is installed yet, which pipefail would turn
    # into a failure of the whole pipeline.
    installed="$(uv tool list --show-paths | grep -v '^- ' | cut -d ' ' -f1 || true)"
    # shellcheck disable=SC2154
    for pip_package in "${pip_packages[@]}"; do
        # -x -F so that a name is not matched as a substring or a regex,
        # otherwise an installed ruff-lsp would look like an installed ruff.
        if grep -qxF -- "$pip_package" <<<"$installed"; then
            echo "Already installed pip_package: $pip_package"
        else
            uv tool install "$pip_package"
        fi
    done
    uv tool upgrade --all
}

install_node_packages() {
    # shellcheck disable=SC2154
    npm install -g "${npm_packages[@]}"
}

# Both installers only put themselves on PATH by appending to the shell
# profiles, which does nothing for a shell that is already running. The shell
# this script was started from is exactly that after the first run, so a second
# run in the same terminal finds nothing on PATH and would install on top of a
# perfectly good installation. Ask for a new shell instead.
exit_if_installed_but_not_on_path() {
    local name="$1" path="$2"
    [ -x "$path" ] || return 0
    echo_err_blue "$name is not on PATH but is installed in $path"
    echo_err_blue "Start a new shell and run this script again"
    exit 1
}

install_macos_packages() {
    if ! xcode-select -p >/dev/null || ! [ -d "/Library/Developer/CommandLineTools/usr/bin" ]; then
        echo "Install Xcode command line tools and run script again"
        echo "xcode-select --install"
        exit 1
    fi

    export HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS=1
    export HOMEBREW_NO_ASK=1
    if ! command -v brew >/dev/null; then
        exit_if_installed_but_not_on_path brew /opt/homebrew/bin/brew
        bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        eval "$(/opt/homebrew/bin/brew shellenv)"
    fi
    brew update
    brew upgrade
    brew bundle

    brew bundle dump --file - >Brewfile.new

    if ! command -v nix >/dev/null; then
        exit_if_installed_but_not_on_path nix /nix/var/nix/profiles/default/bin/nix
        curl -fsSL https://install.determinate.systems/nix | sh -s -- install
        if [ -r '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh' ]; then
            # shellcheck disable=SC1091
            source '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh'
        fi
    fi

    if ! nix profile list --json | grep dotfilez >/dev/null; then
        nix profile add .
    fi
    nix flake update
    nix profile upgrade dotfilez
    nix profile diff-closures | tail -30
    # ~/.nix-profile is a symlink to the profile nix profile manages, so the
    # wipe-history above already covers what nix-env --delete-generations did.
    nix profile wipe-history --older-than 90d
    nix store gc

}

configure_macos() {
    defaults_write .GlobalPreferences com.apple.mouse.scaling -float 0.5
    defaults_write NSGlobalDomain AppleShowAllExtensions -bool true
    defaults_write NSGlobalDomain InitialKeyRepeat -int 12
    defaults_write NSGlobalDomain KeyRepeat -int 1
    defaults_write NSGlobalDomain NSAutomaticDashSubstitutionEnabled -bool false
    defaults_write NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false
    defaults_write NSGlobalDomain NSDocumentSaveNewDocumentsToCloud -bool false
    defaults_write com.apple.desktopservices DSDontWriteNetworkStores -bool true
    defaults_write com.apple.desktopservices DSDontWriteUSBStores -bool true
    defaults_write com.apple.dock autohide -bool true
    defaults_write com.apple.dock orientation -string "right"
    defaults_write com.apple.dock persistent-apps -array
    defaults_write com.apple.dock show-recents -bool false
    defaults_write com.apple.finder AppleShowAllFiles -bool true
    defaults_write com.apple.finder QuitMenuItem -bool true
    defaults_write com.apple.finder ShowPathbar -bool true
    defaults_write com.apple.finder ShowStatusBar -bool true
    defaults_write com.apple.finder _FXShowPosixPathInTitle -bool true
    defaults_write com.apple.screencapture location ~/screenshots
    defaults_write com.apple.screensaver askForPassword -int 1
    defaults_write com.apple.screensaver askForPasswordDelay -int 0
    defaults_write NSGlobalDomain AppleInterfaceStyle Dark
    defaults_write NSGlobalDomain AppleInterfaceStyleSwitchesAutomatically -bool false
    #defaults write ~/Library/Preferences/com.apple.HIToolbox.plist AppleEnabledInputSources -array-add '{ InputSourceKind = "Keyboard Layout"; "KeyboardLayout ID" = 252; "KeyboardLayout Name" = ABC; }'
    #defaults read com.apple.HIToolbox

    # These two only pick up the new values when the app is restarted, so only
    # pay for the restart when something above actually changed.
    if domain_changed com.apple.dock; then
        echo "Dock preferences changed, restarting Dock"
        # launchd only respawns these on an unsuccessful exit (KeepAlive
        # SuccessfulExit=false), so make sure the Dock really comes back.
        killall Dock || true
        open -a Dock
    fi
    if domain_changed com.apple.finder; then
        echo "Finder preferences changed, restarting Finder"
        killall Finder || true
    fi
}

set_hostname() {
    local current_cn new_hn
    current_cn="$(scutil --get ComputerName)"
    cat <<EOF
LocalHostName: $(scutil --get LocalHostName)
ComputerName:  ${current_cn}
HostName:      $(scutil --get HostName)
EOF

    # A clean hostname is lowercase letters, digits and dashes. The name macOS
    # picks by default, "Mattias's MacBook Pro", is not.
    local valid_hostname='^[a-z0-9][a-z0-9-]*$'
    if [[ $current_cn =~ $valid_hostname ]]; then
        echo "Hostname OK"
        return 0
    fi

    read -r -p "Enter a new hostname (lowercase letters, digits and dashes): " new_hn
    echo "Setting hostname to: $new_hn"
    # scutil --set needs super-user access and authenticates per invocation, so
    # run all three in a single sudo to only be asked for the password once.
    # The name is passed as an argument rather than interpolated.
    # shellcheck disable=SC2016
    sudo bash -c '
        set -e
        scutil --set LocalHostName "$1"
        scutil --set ComputerName "$1"
        scutil --set HostName "$1"
    ' _ "$new_hn"
    echo_err_blue "Hostname changed, run the script again to continue the setup"
    exit 1
}

main "$@"
